# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------
VIKASH_HOST=0.0.0.0                          # listen on all interfaces
VIKASH_PORT=8016
VIKASH_WORKERS=4                             # number of worker processes
VIKASH_RELOAD=true                          # auto-reload on code changes (dev only)

# ----------------------------------------------------------------------------
# EMAIL (SMTP) â€“ ðŸ”‘ PASSWORDS REQUIRED FOR ORDER CONFIRMATIONS, PASSWORD RESET
# ----------------------------------------------------------------------------
VIKASH_SMTP_HOST=smtp.gmail.com
VIKASH_SMTP_PORT=587
VIKASH_SMTP_USERNAME=your_email@gmail.com
VIKASH_SMTP_PASSWORD=your_gmail_app_password   # ðŸ”‘
VIKASH_SMTP_USE_TLS=true
VIKASH_SMTP_FROM_EMAIL=noreply@vikash.dev
VIKASH_SMTP_FROM_NAME="Vikash Hardware Store"

# ----------------------------------------------------------------------------
# STORE & CART SETTINGS
# ----------------------------------------------------------------------------
VIKASH_STARTING_BALANCE=0.00
VIKASH_MINIMUM_BALANCE=0.00
VIKASH_MAX_CART_ITEMS=50
VIKASH_MAX_ORDER_QUANTITY=50

# ----------------------------------------------------------------------------
# REDIS / CACHE (optional â€“ ðŸ”‘ PASSWORD IF REQUIRED)
# ----------------------------------------------------------------------------
# VIKASH_REDIS_HOST=localhost
# VIKASH_REDIS_PORT=6379
# VIKASH_REDIS_DB=0
# VIKASH_REDIS_PASSWORD=your_redis_password_if_any   # ðŸ”‘
# VIKASH_CACHE_TTL=300

# ----------------------------------------------------------------------------
# AI / ML FEATURES (development only â€“ keep disabled in production)
# ----------------------------------------------------------------------------
VIKASH_AI_ENABLED=true
VIKASH_QUANTUM_QUBITS=8

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
VIKASH_LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR

# Dev auth fallback (used when MySQL is down in development)
DEV_AUTH_ENABLED=true
DEV_AUTH_USERNAME=dev
DEV_AUTH_EMAIL=dev@local
DEV_AUTH_PASSWORD=devpass

